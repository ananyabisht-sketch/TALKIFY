sessions[i].topic, status, sessions[i].host, sessions[i].location, sessions[i].time);
found = 1;
}
}
}
}
if (!found) printf("\nNo sessions found for this branch.\n");
}
else if (choice == 2) {
printf("\nEnter hobby to filter (e.g., Coding, Football):\n");
getchar(); fgets(input, sizeof(input), stdin); input[strcspn(input, "\n")] = '\0';
char inputLower[400]; toLowerCase(input, inputLower);
int found = 0;
printf("\n--- Sessions filtered by hobby: %s ---\n", input);
for (int i = 0; i < sessionCount; i++) {
for (int u = 0; u < userCount; u++) {
if (strcmp(sessions[i].host, users[u].username) == 0) {
char hobbyLower[600]; toLowerCase(users[u].hobbies, hobbyLower);
if (strstr(hobbyLower, inputLower) != NULL) {
int dur = atoi(sessions[i].duration);
const char *status = (dur > TIME_LIMIT) ? "EXPIRED" : "ACTIVE";
printf("\nSession: %s (%s)\nHost: %s\nLocation: %s\nTime: %s\n",
sessions[i].topic, status, sessions[i].host, sessions[i].location, sessions[i].time);
found = 1;
}
}
}
}
if (!found) printf("\nNo sessions found for this hobby.\n");
}
else if (choice == 3) {
printf("\nEnter semester to filter (1 - 10): ");
if (scanf("%d", &semChoice) != 1) { while(getchar()!='\n'); printf("Invalid input.\n"); return; }
int found = 0;
printf("\n--- Sessions filtered by semester: %d ---\n", semChoice);
for (int i = 0; i < sessionCount; i++) {
for (int u = 0; u < userCount; u++) {
if (strcmp(sessions[i].host, users[u].username) == 0 && users[u].semester == semChoice) {
int dur = atoi(sessions[i].duration);
const char *status = (dur > TIME_LIMIT) ? "EXPIRED" : "ACTIVE";
printf("\nSession: %s (%s)\nHost: %s\nLocation: %s\nTime: %s\n",
sessions[i].topic, status, sessions[i].host, sessions[i].location, sessions[i].time);
found = 1;
}
}
}
if (!found) printf("\nNo sessions found for this semester.\n");
}
else {
printf("\nInvalid option.\n");
}
}
