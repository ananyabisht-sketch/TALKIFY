void filterSessions() {
if (sessionCount == 0) {
printf("\nNo sessions available to filter.\n");
return;
}
printf("\n====== FILTER SESSIONS ======\n");
printf("1. Filter by Branch\n2. Filter by Hobby\n3. Filter by Semester\nEnter choice: ");
int choice;
if (scanf("%d", &choice) != 1) { while(getchar()!='\n'); printf("Invalid input.\n"); return; }
char input[300];
int semChoice;
if (choice == 1) {
printf("\nEnter branch to filter (partial allowed):\n");
getchar(); fgets(input, sizeof(input), stdin); input[strcspn(input, "\n")] = '\0';
char inputLower[400]; toLowerCase(input, inputLower);
int found = 0;
printf("\n--- Sessions filtered by branch: %s ---\n", input);
