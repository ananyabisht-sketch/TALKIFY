void loadFiles() {
  FILE *fu = fopen("users.txt", "r");
FILE *fs = fopen("sessions.txt", "r");
 FILE *fe = fopen("events.txt", "r");
if (fu) {
while (userCount < MAX_USERS) 
{        
char biobuf[200];
int sem;
int read = fscanf(fu, "%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%d|%[^\n]\n",
users[userCount].username,
  users[userCount].password,
users[userCount].fullName,
 users[userCount].gender,
users[userCount].email,
users[userCount].branch,
 users[userCount].subject,
users[userCount].hobbies,
&sem,
 biobuf);
if (read != 10) break;
users[userCount].semester = sem;
strncpy(users[userCount].bio, biobuf, sizeof(users[userCount].bio)-1);
users[userCount].bio[sizeof(users[userCount].bio)-1] = '\0';
 userCount++;
}
fclose(fu);
 }
if (fs) {
while (sessionCount < MAX_SESSIONS) {
int read = fscanf(fs, "%[^|]|%[^|]|%[^|]|%[^|]|%[^\n]\n",
sessions[sessionCount].host,
 sessions[sessionCount].topic,
sessions[sessionCount].location,
sessions[sessionCount].time,
sessions[sessionCount].duration);
if (read != 5) break;
sessionCount++;
}
 fclose(fs);
}
if (fe) {
while (eventCount < MAX_EVENTS) {
int read = fscanf(fe, "%[^|]|%[^|]|%[^\n]\n",
events[eventCount].name,
events[eventCount].field,
events[eventCount].date);
if (read != 3) break;
eventCount++;
}
 fclose(fe);
}
}
