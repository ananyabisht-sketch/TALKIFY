void viewMatchingSessions() {
if (strlen(currentSubject) == 0) {
printf("You must be logged in to view matching sessions.\n");
return;
}
char subLower[300];
toLowerCase(currentSubject, subLower);
int foundIndexes[MAX_SESSIONS];
int foundCount = 0;
printf("\n--- Matching Sessions for %s (%s) ---\n", currentUser, currentSubject);
for (int i = 0; i < sessionCount; i++) {
char topicLower[400];
toLowerCase(sessions[i].topic, topicLower);
if (strstr(topicLower, subLower) != NULL) {
foundIndexes[foundCount++] = i;
int dur = atoi(sessions[i].duration);
const char *status = (dur > TIME_LIMIT) ? "EXPIRED" : "ACTIVE";
printf("\n[%d] %s (%s)\n Host: %s\n Location: %s\n Time: %s\n Duration: %s minutes\n",
foundCount, sessions[i].topic, status, sessions[i].host, sessions[i].location, sessions[i].time, sessions[i].duration);
}
}
if (foundCount == 0) {
printf("\nNo matching sessions found for %s.\n", currentSubject);
return;
}
int choice;
printf("\nEnter the number of the session to view host details (0 to cancel): ");
if (scanf("%d", &choice) != 1) { while(getchar()!='\n'); printf("Invalid input.\n"); return; }
if (choice == 0) return;
if (choice < 1 || choice > foundCount) {
printf("Invalid choice.\n");
return;
}
int sessionIndex = foundIndexes[choice - 1];
showUserDetails(sessions[sessionIndex].host);
}
